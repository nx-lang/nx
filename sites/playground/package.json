{
  "name": "@nx-lang/playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The NX Playground: edit NX on the left and see what its root returns on the right, in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-transform-types --test --test-force-exit \"worker/*.test.mjs\" \"headers.test.mjs\" \"src/**/*.test.mjs\" \"vite.config.test.mjs\" && pnpm run check-examples",
    "check-examples": "node --no-warnings --experimental-transform-types scripts/check-examples.mjs"
  },
  "dependencies": {
    "@nx-lang/language": "file:../../src/vscode",
    "@nx-lang/language-core": "workspace:*",
    "@nx-lang/language-protocol": "workspace:*",
    "@nx-lang/monaco": "workspace:*",
    "@nx-lang/sdk-wasm": "workspace:*",
    "@nx-lang/value-view": "workspace:*",
    "@shikijs/monaco": "^4.4.3",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
