<Page
  children={<Banner body="Add seats before you invite anyone else." title="Every seat is in use" tone=warning /> <Section
    children={<TextField
      label="Name"
      onChanged=<ActionHandler action="TextField.Changed" token="h1-1" />
      placeholder="Your team or company"
      value="Hive5 Tools"
    /> <TextField
      help="hive5.example.com/hive5-tools"
      label="Web address"
      onChanged=<ActionHandler action="TextField.Changed" token="h1-2" />
      value="hive5-tools"
    />}
    description="How this workspace appears to the people in it."
    title="General"
  /> <Section
    children={<Toggle
      help="People without it are asked to set it up the next time they sign in."
      label="Require two-factor sign-in"
      on=false
      onToggled=<ActionHandler action="Toggle.Toggled" token="h1-3" />
    />}
    title="Security"
  /> <Section
    children={<Stack
      children={<Row
        children={<Avatar name="Ada Lovelace" /> <Stack
          children={<Text style=body text="Ada Lovelace" tone=neutral /> <Text style=caption text="ada@example.com" tone=neutral />}
          gap=none
        /> <Badge label="Owner" tone=success /> <Text style=caption text="Today" tone=neutral />}
        gap=medium
      /> <Row
        children={<Avatar name="Grace Hopper" /> <Stack
          children={<Text style=body text="Grace Hopper" tone=neutral /> <Text style=caption text="grace@example.com" tone=neutral />}
          gap=none
        /> <Badge label="Admin" tone=warning /> <Text style=caption text="Yesterday" tone=neutral /> <Button
          disabled=false
          kind=destructive
          label="Remove"
          onTapped=<ActionHandler action="Button.Tapped" token="h1-4" />
        />}
        gap=medium
      /> <Row
        children={<Avatar name="Barbara Liskov" /> <Stack
          children={<Text style=body text="Barbara Liskov" tone=neutral /> <Text style=caption text="barbara@example.com" tone=neutral />}
          gap=none
        /> <Badge label="Member" tone=neutral /> <Badge label="No two-factor" tone=danger /> <Text style=caption text="3 days ago" tone=neutral /> <Button
          disabled=false
          kind=destructive
          label="Remove"
          onTapped=<ActionHandler action="Button.Tapped" token="h1-5" />
        />}
        gap=medium
      /> <Row
        children={<Avatar name="Margaret Hamilton" /> <Stack
          children={<Text style=body text="Margaret Hamilton" tone=neutral /> <Text style=caption text="margaret@example.com" tone=neutral />}
          gap=none
        /> <Badge label="Member" tone=neutral /> <Text style=caption text="Never signed in" tone=neutral /> <Button
          disabled=false
          kind=destructive
          label="Remove"
          onTapped=<ActionHandler action="Button.Tapped" token="h1-6" />
        />}
        gap=medium
      /> <Row
        children={<Avatar name="Katherine Johnson" /> <Stack
          children={<Text style=body text="Katherine Johnson" tone=neutral /> <Text style=caption text="katherine@example.com" tone=neutral />}
          gap=none
        /> <Badge label="Guest" tone=neutral /> <Badge label="No two-factor" tone=danger /> <Text style=caption text="Last month" tone=neutral /> <Button
          disabled=false
          kind=destructive
          label="Remove"
          onTapped=<ActionHandler action="Button.Tapped" token="h1-7" />
        />}
        gap=medium
      />}
      gap=small
    /> <Button disabled=false kind=primary label="Invite people" />}
    description="Everyone who can open this workspace."
    title="Members"
  /> <Divider /> <Row
    children={<Button
      disabled=false
      kind=primary
      label="Save changes"
      onTapped=<ActionHandler action="Button.Tapped" token="h1-8" />
    /> <Button
      disabled=false
      kind=destructive
      label="Delete workspace"
      onTapped=<ActionHandler action="Button.Tapped" token="h1-9" />
    />}
    gap=small
  />}
  subtitle="Team plan, 5 of 5 seats in use"
  title="Workspace settings"
/>
