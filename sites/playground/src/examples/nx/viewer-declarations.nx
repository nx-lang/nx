import "@nx/viewer"

// Viewer declarations say how a reader sees a type, not what it is.
// Switch to Read to see the reading follow them.

type Size = small | medium | large
type Swatch = string

type Drink = {
  name:string
  size:Size = medium
  iced:boolean = false
  color?:Swatch
}

viewer Size =
  <UnionViewer>
    <CaseViewer of=small label="Small (8 oz)" />
    <CaseViewer of=medium label="Medium (12 oz)" />
    <CaseViewer of=large label="Large (16 oz)" />
  </UnionViewer>
viewer Swatch = <ValueViewer format=color />
viewer Drink =
  <ElementViewer title=name>
    <PropertyViewer of=iced whenTrue="Iced" whenFalse="Hot" />
  </ElementViewer>

let root(): Drink+ = {
  <Drink name="Latte" />
  <Drink name="Cold brew" size=large iced={true} color="#5a3a22" />
}
