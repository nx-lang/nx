// Ported from the DrawnUI React demo's Carousel & Drawer page.
//
// The carousels swipe, wrap and snap and the drawer drags on their own: snapping is the control's
// gesture handling, not authored NX. Everything the original drives from outside them is the
// page's state here — the toggles that flip IsLooped, Bounces, IsVertical or SidesOffset, the
// buttons that move a carousel, the dot that stretches to mark the current slide, the drawer's
// button, and every readout. An index, an offset and a speed are numbers and IsOpen is a boolean;
// each converts to text where `+` joins it to its label.
//
// Where the original calls a method on a control — GoPrev, GoNext, ScrollTo, Close — this port
// sets the property the method would have changed, since NX cannot call into a control. Two of
// the carousels also recycle their slides through ItemsSource and an ItemTemplate (list
// virtualization); here the same slides are static children.

type Slide = {
  Title: string
  Color: string
  Text: string
}

component <Card extends DrawnNode Title:string content Children:DrawnNode[] /> = {
  <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=8 />
    BackgroundColor="#2B3035" HorizontalOptions=Fill>
    <SkiaStack Padding=<Thickness Left=16 Top=12 Right=16 Bottom=12 /> Spacing=10>
      <SkiaLabel Text={Title} FontSize=12 TextColor="#6EA8FE" FontAttributes=Bold
        TextTransform=Uppercase />
      {Children}
    </SkiaStack>
  </SkiaShape>
}

// A toggle button. It holds nothing itself: the page owns the flag and flips it when this taps.
component <Toggle extends DrawnNode Text:string On:boolean emits { Tapped { } } /> = {
  <SkiaButton Text={Text + if On { ": On" } else { ": Off" }} FontSize=13
    BackgroundColor={if On { "#20C997" } else { "#495057" }}
    TextColor={if On { "#1A1A2E" } else { "#FFFFFF" }} onTapped=<Toggle.Tapped /> />
}

let speeds:float64[] = { 0.5 1.0 2.0 }

// The looped carousel's twelve slides, by color: the original cycles six colors by index.
let loopColors = {
  "#0D6EFD" "#6610F2" "#D63384" "#20C997" "#FD7E14" "#0DCAF0"
  "#0D6EFD" "#6610F2" "#D63384" "#20C997" "#FD7E14" "#0DCAF0"
}

// The playground's big slides: a number filling a plain rectangle.
component <BigSlide extends DrawnNode Item:Slide /> = {
  <SkiaShape Type=Rectangle BackgroundColor={Item.Color} UseCache=Operations>
    <SkiaLabel Text={Item.Title} FontSize=60 FontFamily="FontTextBold" TextColor={Item.Text}
      HorizontalOptions=Center VerticalOptions=Center />
  </SkiaShape>
}

// The original's SlideCell, a recycled cell whose footer reports its index; here a plain component
// with the index written in.
component <SlideFace extends DrawnNode Item:Slide Size:float64 Sub:string? Height:float64? /> = {
  <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=12 /> BackgroundColor={Item.Color}
    HorizontalOptions=Fill VerticalOptions=Fill HeightRequest={Height}>
    <SkiaLabel Text={Item.Title} FontSize={Size} FontFamily="FontTextBold" TextColor="#FFFFFF"
      HorizontalOptions=Center VerticalOptions=Center />
    <SkiaLabel Text={Sub} FontSize=12 TextColor="#FFFFFFAA" HorizontalOptions=Center
      VerticalOptions=End Margin=<Thickness Bottom=10 /> />
  </SkiaShape>
}

let big = {
  <Slide Title="1" Color="#E94560" Text="#FFFFFF" />
  <Slide Title="2" Color="#0F3460" Text="#FFFFFF" />
  <Slide Title="3" Color="#533483" Text="#FFFFFF" />
  <Slide Title="4" Color="#A8DF8E" Text="#1A1A2E" />
}

let peek = {
  <Slide Title="Slide 1" Color="#0D6EFD" Text="#FFFFFF" />
  <Slide Title="Slide 2" Color="#6610F2" Text="#FFFFFF" />
  <Slide Title="Slide 3" Color="#D63384" Text="#FFFFFF" />
  <Slide Title="Slide 4" Color="#20C997" Text="#FFFFFF" />
}

component <Page /> = {
  state {
    index:float64 = 0
    looped:boolean = false
    bounces:boolean = false
    preload:boolean = true
    vertical:boolean = false
    sides:float64 = 40
    speed:float64 = 1
    inTransition:boolean = false
    appeared:string = ""
    peekIndex:float64 = 1
    loopIndex:float64 = 0
    dynIndex:float64 = 0
    open:boolean = false
  }

  <SkiaLayer VerticalOptions=Fill>
    <SkiaScroll Orientation=Vertical>
      <SkiaStack Spacing=16 Padding=<Thickness Left=16 Top=16 Right=16 Bottom=260 />
        HorizontalOptions=Center MaximumWidthRequest=720>
        <SkiaLabel Text="Carousel & Drawer" FontSize=24 TextColor="#FFFFFF" HorizontalOptions=Center />

        <Card Title="SkiaCarousel playground (Sandbox MainPageCarousels)">
          <SkiaWrap Spacing=8>
            <Toggle Text="IsLooped" On={looped} onTapped=<Update looped={!looped} /> />
            <Toggle Text="Bounces" On={bounces} onTapped=<Update bounces={!bounces} /> />
            <Toggle Text="PreloadNeighboors" On={preload} onTapped=<Update preload={!preload} /> />
            <Toggle Text="IsVertical" On={vertical} onTapped=<Update vertical={!vertical} /> />
            // Cycles 40, 0, 20. The offset is a float64, and a whole one prints without a fraction.
            <SkiaButton Text={"SidesOffset: " + sides} BackgroundColor="#495057" FontSize=13
              onTapped=<Update sides={if sides == 40 { 0 } else { if sides == 0 { 20 } else { 40 } }} /> />
          </SkiaWrap>
          // The original calls GoPrev(), GoNext() and ScrollTo() on the carousel. NX cannot call a
          // method, so these set SelectedIndex, which the carousel follows. Two differences come
          // with that: Prev and Next stop at the ends where the methods wrap a looped carousel, and
          // "no anim" animates like the rest, since skipping the animation is the method's argument.
          <SkiaWrap Spacing=8>
            <SkiaButton Text="← Prev" FontFamilyFallback="FontSymbols,FontSymbols2" BackgroundColor="#0F3460" FontSize=13
              onTapped=<Update index={if index > 0 { index - 1 } else { index }} /> />
            <SkiaButton Text="Next →" FontFamilyFallback="FontSymbols,FontSymbols2" BackgroundColor="#0F3460" FontSize=13
              onTapped=<Update index={if index < 3 { index + 1 } else { index }} /> />
            <SkiaButton Text="ScrollTo(2)" BackgroundColor="#0F3460" FontSize=13 onTapped=<Update index=2 /> />
            <SkiaButton Text="ScrollTo(0, no anim)" BackgroundColor="#0F3460" FontSize=13
              onTapped=<Update index=0 /> />
            <SkiaButton Text="Set index 3" BackgroundColor="#0F3460" FontSize=13 onTapped=<Update index=3 /> />
          </SkiaWrap>
          <SkiaCarousel HeightRequest=250 BackgroundColor="#16213E" IsLooped={looped} Bounces={bounces}
            SwipeSpeed={speed} SidesOffset={sides} Spacing=20 PreloadNeighboors={preload}
            IsVertical={vertical} SelectedIndex={index}
            onSelectedIndexChanged=<Update index={action.index} />
            onTransitionChanged=<Update inTransition={action.inTransition} />
            onItemAppearing=<Update appeared={"ItemAppearing " + action.index} />
            onItemDisappearing=<Update appeared={"ItemDisappearing " + action.index} />>
            for slide in big {
              <BigSlide Item={slide} />
            }
          </SkiaCarousel>
          // Indicators: the selected dot stretches to 24. The loop's position is an int and the
          // selected index a float64; the comparison widens the int.
          <SkiaRow Spacing=8 HorizontalOptions=Center>
            for slide, position in big {
              <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=4 /> HeightRequest=8
                WidthRequest={if position == index { 24 } else { 8 }} BackgroundColor={slide.Color} />
            }
          </SkiaRow>
          <SkiaLabel FontSize=13 TextColor="#ADB5BD" HorizontalOptions=Fill
            Text={"Selected Index: " + index + "   ·   InTransition: " + inTransition + "   ·   "
              + if looped { "Looping enabled - infinite scroll" } else { "Looping disabled - bounded scroll" }
              + "   ·   " + appeared} />
          <SkiaRow Spacing=8 VerticalOptions=Center>
            <SkiaLabel Text="Swipe Speed" FontSize=14 TextColor="#FFFFFF" VerticalOptions=Center />
            // The original pads these with toFixed(1): "1.0x". NX has one text form for a float64,
            // the one JavaScript's own conversion gives, so a whole speed reads "1x".
            for v in speeds {
              <SkiaButton Text={v + "x"} FontSize=13
                BackgroundColor={if speed == v { "#533483" } else { "#495057" }}
                onTapped=<Update speed={v} /> />
            }
            <SkiaLabel Text={"Current: " + speed + "x"} FontSize=12 TextColor="#ADB5BD" VerticalOptions=Center />
          </SkiaRow>
        </Card>

        <Card Title={"SidesOffset={40} Spacing={12} — neighbours peek in · SelectedIndex=" + peekIndex}>
          <SkiaCarousel HeightRequest=140 SidesOffset=40 Spacing=12 SelectedIndex={peekIndex}
            onSelectedIndexChanged=<Update peekIndex={action.index} />>
            for slide in peek {
              <SlideFace Item={slide} Size=20 />
            }
          </SkiaCarousel>
        </Card>

        <Card Title={"IsLooped + 12 slides (the original recycles them through ItemsSource) · SelectedIndex=" + loopIndex}>
          <SkiaCarousel HeightRequest=130 IsLooped=true SidesOffset=30 Spacing=10 LinearSpeedMs=350
            SelectedIndex={loopIndex} onSelectedIndexChanged=<Update loopIndex={action.index} />>
            // "Item 1" … "Item 12": the loop's position converts to text in the title and the footer.
            for color, position in loopColors {
              <SlideFace Item=<Slide Title={"Item " + (position + 1)} Color={color} Text="#FFFFFF" /> Size=22
                Sub={"static child · index " + position} />
            }
          </SkiaCarousel>
          <SkiaRow Spacing=8>
            // GoPrev() and GoNext() in the original; here the index wraps by hand, as they do.
            <SkiaButton Text="Prev" BackgroundColor="#0D6EFD"
              onTapped=<Update loopIndex={if loopIndex > 0 { loopIndex - 1 } else { 11 }} /> />
            <SkiaButton Text="Next" BackgroundColor="#0D6EFD"
              onTapped=<Update loopIndex={if loopIndex < 11 { loopIndex + 1 } else { 0 }} /> />
            <SkiaLabel FontFamilyFallback="FontSymbols,FontSymbols2" FontSize=12 TextColor="#ADB5BD"
              VerticalOptions=Center HorizontalOptions=Fill
              Text="Wraps last → first both ways (virtual anchors); LinearSpeedMs=350 = one slide per 350 ms without Bounces. The original recycles cells through ItemTemplate; these twelve are static." />
          </SkiaRow>
        </Card>

        <Card Title={"DynamicSize — auto height follows the selected slide · SelectedIndex=" + dynIndex}>
          <SkiaCarousel DynamicSize=true VerticalOptions=Start Bounces=true SelectedIndex={dynIndex}
            onSelectedIndexChanged=<Update dynIndex={action.index} />>
            <SlideFace Item=<Slide Title="80 pt" Color="#0D6EFD" Text="#FFFFFF" /> Size=22 Sub="static child · index 0" Height=80 />
            <SlideFace Item=<Slide Title="160 pt" Color="#6610F2" Text="#FFFFFF" /> Size=22 Sub="static child · index 1" Height=160 />
            <SlideFace Item=<Slide Title="110 pt" Color="#20C997" Text="#FFFFFF" /> Size=22 Sub="static child · index 2" Height=110 />
          </SkiaCarousel>
          <SkiaLabel FontSize=12 TextColor="#ADB5BD" HorizontalOptions=Fill
            Text="No HeightRequest: the carousel measures the selected slide (80 / 160 / 110 pt) and re-measures on every index change." />
        </Card>

        <Card Title="SkiaDrawer — drag the header below, or:">
          // The drawer's IsOpen is the page's flag: the button flips it, a drag reports it back, and
          // the boolean converts to text in the readout.
          <SkiaRow Spacing=8>
            <SkiaButton Text={if open { "Close drawer" } else { "Open drawer" }} BackgroundColor="#6610F2"
              onTapped=<Update open={!open} /> />
            <SkiaLabel Text={"IsOpen: " + open} FontSize=14 TextColor="#DEE2E6" VerticalOptions=Center />
          </SkiaRow>
          <SkiaLabel FontSize=12 TextColor="#ADB5BD" HorizontalOptions=Fill
            Text="Direction=FromBottom HeaderSize=56, sits in a SkiaLayer with VerticalOptions=End; snaps by velocity, Bounces enabled." />
        </Card>
      </SkiaStack>
    </SkiaScroll>

    // The drawer lives in its own full-size layer over the page, anchored to the bottom edge, and
    // rests closed with only its header showing. The top corners alone are rounded, like a MAUI
    // CornerRadius="20,20,0,0"; the bottom corners are written as zero because an unset corner
    // mirrors the first.
    <SkiaLayer VerticalOptions=Fill>
      <SkiaDrawer Direction=FromBottom HeaderSize=56 HeightRequest=320 VerticalOptions=End
        HorizontalOptions=Fill Bounces=true IsOpen={open} onIsOpenChanged=<Update open={action.isOpen} />>
        <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=20 TopRight=20 BottomLeft=0 BottomRight=0 />
          BackgroundColor="#F5F5F5" HorizontalOptions=Fill VerticalOptions=Fill
          Shadows={ <SkiaShadow X=0 Y=-2 Blur=8 Opacity=0.4 Color="#000000" /> }>
          <SkiaStack Spacing=0 HorizontalOptions=Fill>
            <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=20 TopRight=20 BottomLeft=0 BottomRight=0 />
              BackgroundColor="#0D6EFD" HeightRequest=56 HorizontalOptions=Fill>
              <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=3 /> BackgroundColor="#FFFFFF"
                WidthRequest=44 HeightRequest=5 HorizontalOptions=Center Margin=<Thickness Top=8 /> />
              <SkiaLabel Text="Drag me" FontSize=16 FontFamily="FontTextBold" TextColor="#FFFFFF"
                HorizontalOptions=Center VerticalOptions=Center Margin=<Thickness Top=10 /> />
            </SkiaShape>
            <SkiaStack Padding=<Thickness Left=20 Top=20 Right=20 Bottom=20 /> Spacing=12>
              <SkiaLabel Text="Drawer content" FontSize=20 FontFamily="FontTextBold" TextColor="#111827" />
              <SkiaLabel FontSize=14 TextColor="#374151" HorizontalOptions=Fill
                Text="Everything inside is a normal drawn tree: buttons keep working, the drawer only takes vertical drags. Release with a flick to snap open or closed." />
              // Close() in the original; here the page's flag, which the drawer follows.
              <SkiaButton Text="Close" ControlStyle=Material onTapped=<Update open=false /> />
            </SkiaStack>
          </SkiaStack>
        </SkiaShape>
      </SkiaDrawer>
    </SkiaLayer>
  </SkiaLayer>
}

<Page />
