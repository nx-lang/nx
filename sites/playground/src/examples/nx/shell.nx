// Ported from the DrawnUI React demo's Shell page.
//
// SkiaShell: pages with slide transitions, popups, modals, toasts, tabs, browser back. Almost all
// of it is navigation driven from code — GoToAsync, OpenPopupAsync, PushModalAsync, ShowToast —
// which needs event handlers, and the status line at the top reads the shell's live state, which
// needs component state. The buttons are drawn and do nothing; the status line shows the state
// the page opens in.
//
// The nested tabbed shell is not ported at all: SkiaShell is a React component, not a drawn
// control, so the catalog has nothing to put there. Its card keeps a note in its place.
//
// The one card that ports in full is the SkiaBackdrop frosted glass: a backdrop is a drawn control
// that blurs what is behind it, and needs nothing from outside.

component <Card extends DrawnNode Title:string content Children:DrawnNode[] /> = {
  <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=8 />
    BackgroundColor="#2B3035" HorizontalOptions=Fill>
    <SkiaStack Padding=<Thickness Left=16 Top=12 Right=16 Bottom=12 /> Spacing=10>
      <SkiaLabel Text={Title} FontSize=12 TextColor="#6EA8FE" FontAttributes=Bold
        TextTransform=Uppercase />
      {Children}
    </SkiaStack>
  </SkiaShape>
}

<SkiaScroll Orientation=Vertical>
  <SkiaStack Spacing=16 Padding=<Thickness Left=16 Top=16 Right=16 Bottom=16 />
    HorizontalOptions=Center MaximumWidthRequest=720>
    <SkiaLabel Text="SkiaShell" FontSize=24 TextColor="#FFFFFF" HorizontalOptions=Center />
    <SkiaLabel FontSize=12 TextColor="#ADB5BD" HorizontalOptions=Fill
      Text="Route=shell · NavigationStack=[shell] · Popups=0 · Modals=0 · Toasts=0" />
    <SkiaLabel FontSize=12 TextColor="#ADB5BD" HorizontalOptions=Fill
      Text="Pages live in the URL hash (#/shell/shapes); the browser Back button closes the top popup, then the top modal, then pops the page — the C# GoBack order." />

    <Card Title="Pages — GoToAsync slides the page in from the right (PagesAnimationSpeed 200 ms), GoBackAsync slides it out">
      <SkiaWrap Spacing=8>
        <SkiaButton Text="GoToAsync('shapes')" BackgroundColor="#0D6EFD" />
        <SkiaButton Text="GoToAsync('shell') again" BackgroundColor="#0D6EFD" />
        <SkiaButton Text="GoBackAsync()" BackgroundColor="#495057" />
        <SkiaButton Text="PopToRootAsync()" BackgroundColor="#495057" />
      </SkiaWrap>
    </Card>

    <Card Title="Tabs — a nested SkiaShell with Tabs: per-tab navigation stacks, AnimateTabs (C# SkiaViewSwitcher slide + fade), PopTabToRootAsync">
      <SkiaLayer HeightRequest=120 HorizontalOptions=Fill BackgroundColor="#212529">
        <SkiaLabel FontSize=12 TextColor="#ADB5BD" HorizontalOptions=Center VerticalOptions=Center
          HorizontalTextAlignment=Center MaximumWidthRequest=560
          Text="The original embeds a second SkiaShell here with Home, Search and Profile tabs, each with its own stack, and logs its Navigating / Navigated / RouteChanged events. SkiaShell is a React component rather than a drawn control, so there is nothing in the catalog to draw in its place." />
      </SkiaLayer>
    </Card>

    <Card Title="SkiaBackdrop — the Sandbox MainPageBackdrop frosted glass, same tree">
      // Sandbox: scroll content UseCache=Image (the backdrop snapshots that offscreen surface),
      // baboon, then a 200x200 composition.
      <SkiaLayer HeightRequest=260 HorizontalOptions=Fill IsClippedToBounds=true UseCache=Image
        BackgroundColor="#F5F5F5" Padding=<Thickness Left=24 Top=24 Right=24 Bottom=24 />>
        <SkiaImage Source="images/baboon.jpg" Aspect=AspectCover BackgroundColor="#008000"
          HorizontalOptions=Fill VerticalOptions=Fill />
        <SkiaLayer WidthRequest=200 HeightRequest=200 HorizontalOptions=Center VerticalOptions=Center>
          // Static shadow + texture, cached.
          <SkiaLayer Padding=<Thickness Left=16 Top=16 Right=16 Bottom=16 /> HorizontalOptions=Fill
            VerticalOptions=Fill UseCache=Image ZIndex=-1>
            <SkiaShape Type=Rectangle BackgroundColor="#22DDDDDD" CornerRadius=<CornerRadius TopLeft=16 />
              StrokeColor="#FF0000" StrokeWidth=2 HorizontalOptions=Fill VerticalOptions=Fill
              StrokeGradient=<SkiaGradient Type=Linear StartXRatio=0.0 StartYRatio=0.0 EndXRatio=1.0 EndYRatio=1.0
                Colors={ "#66FFFFFF" "#66999999" } />>
              <SkiaImage Source="images/glass2.jpg" Aspect=AspectCover Opacity=0.15
                HorizontalOptions=Fill VerticalOptions=Fill />
            </SkiaShape>
          </SkiaLayer>
          // The backdrop itself.
          <SkiaShape Type=Rectangle Margin=<Thickness Left=16 Top=16 Right=16 Bottom=16 />
            BackgroundColor="#66FFFFFF" ClipBackgroundColor=true CornerRadius=<CornerRadius TopLeft=19 />
            HorizontalOptions=Fill VerticalOptions=Fill
            Shadows={ <SkiaShadow X=4 Y=4 Blur=3 Opacity=1 Color="#44000000" /> }>
            <SkiaLayer>
              <SkiaBackdrop Blur=3 UseContext=true HorizontalOptions=Fill VerticalOptions=Fill ZIndex=-1 />
              <SkiaLayer Padding=<Thickness Left=8 Top=8 Right=8 Bottom=8 /> HorizontalOptions=Fill VerticalOptions=Fill>
                <SkiaLabel Text="Wonnabe Frosted Glass" FontSize=20 TextColor="#EFEFEF" HorizontalOptions=Center
                  HorizontalTextAlignment=Center VerticalOptions=Center />
              </SkiaLayer>
            </SkiaLayer>
          </SkiaShape>
        </SkiaLayer>
      </SkiaLayer>
    </Card>

    <Card Title="Popups — OpenPopupAsync(content, options)">
      <SkiaWrap Spacing=8>
        <SkiaButton Text="Open popup" BackgroundColor="#6610F2" />
        <SkiaButton Text="Not closable outside" BackgroundColor="#6610F2" />
        <SkiaButton Text="No overlay, not animated" BackgroundColor="#6610F2" />
        <SkiaButton Text="Red overlay" BackgroundColor="#6610F2" />
        <SkiaButton Text="CloseAllPopups()" BackgroundColor="#495057" />
      </SkiaWrap>
    </Card>

    <Card Title="Modals — PushModalAsync(content, { useGestures, animated })">
      <SkiaWrap Spacing=8>
        <SkiaButton Text="Push modal" BackgroundColor="#20C997" TextColor="#1A1A2E" />
        <SkiaButton Text="Draggable (useGestures)" BackgroundColor="#20C997" TextColor="#1A1A2E" />
        <SkiaButton Text="Not animated" BackgroundColor="#20C997" TextColor="#1A1A2E" />
      </SkiaWrap>
    </Card>

    <Card Title="Toasts — ShowToast(text | content, msShowTime)">
      <SkiaWrap Spacing=8>
        <SkiaButton Text="ShowToast('Saved!')" BackgroundColor="#FD7E14" TextColor="#1A1A2E" />
        <SkiaButton Text="Short (1.5 s)" BackgroundColor="#FD7E14" TextColor="#1A1A2E" />
        <SkiaButton Text="Custom content" BackgroundColor="#FD7E14" TextColor="#1A1A2E" />
        <SkiaButton Text="CloseAllToasts()" BackgroundColor="#495057" />
      </SkiaWrap>
    </Card>
  </SkiaStack>
</SkiaScroll>
