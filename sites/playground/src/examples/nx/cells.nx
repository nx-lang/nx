// Ported from the DrawnUI React demo's Recycled cells page.
//
// The original is a virtualized list: 100 000 items bound through ItemsSource with an ItemTemplate,
// RecyclingTemplate=Enabled and MeasureItemsStrategy=MeasureFirst, so only the visible cells exist
// and scrolling reuses them. That is what this is too: the cell is an element function, the
// collection is bound through ItemsSource, and DrawnUI realizes, recycles and measures the cells.
//
// The jump toolbar is left out: it scrolls by index from code-behind (ScrollToIndex on the scroll),
// which NX has no way to reach.

type Contact = {
  Id: int
  Initials: string
  Title: string
  Subtitle: string
}

// The collection the original binds: a hundred thousand contacts, counted out by a range.
let contacts = {
  for id in 1..=100000 {
    <Contact Id={id} Initials={"" + id % 100} Title={"Contact " + id}
      Subtitle={"Recycled drawn cell #" + id + " — scroll me fast"} />
  }
}

// The cell the original builds imperatively in ContactCell: an absolute layout with the avatar at
// the start and the text column filling the remaining width, cached as one bitmap. An element
// function, so DrawnUI calls it once per cell it binds, with the item and its index.
let <ContactCell Item:Contact Index:int />: DrawnNode =
  <SkiaLayout Type=Absolute Padding=<Thickness Left=12 Top=10 Right=12 Bottom=10 />
    BackgroundColor={if Index % 2 == 1 { "#0B1220" } else { "#111827" }} UseCache=Image AnimationTapped=Ripple
    HorizontalOptions=Fill>
    <SkiaShape Type=Circle WidthRequest=42 LockRatio=1
      VerticalOptions=Center BackgroundColor="#1F2937">
      <SkiaLabel Text={Item.Initials} FontSize=14 TextColor="#67E8F9"
        HorizontalOptions=Center VerticalOptions=Center />
    </SkiaShape>
    <SkiaStack Margin=<Thickness Left=54 /> Spacing=3
      VerticalOptions=Center HorizontalOptions=Fill>
      <SkiaLabel Text={Item.Title} FontSize=15 TextColor="#FFFFFF" />
      <SkiaLabel Text={Item.Subtitle} FontSize=12 TextColor="#94A3B8" MaxLines=1 />
    </SkiaStack>
  </SkiaLayout>

<SkiaLayer VerticalOptions=Fill>
  <SkiaLabel Text="100 000 recycled cells" FontSize=13 TextColor="#D3D3D3" HorizontalOptions=Center
    Margin=<Thickness Top=10 /> />
  <SkiaScroll Orientation=Vertical Margin=<Thickness Top=36 />>
    <SkiaStack TItem=Contact ItemsSource={contacts} ItemTemplate={ContactCell}
      RecyclingTemplate=Enabled MeasureItemsStrategy=MeasureFirst
      Spacing=8 Padding=<Thickness Left=16 Top=8 Right=16 Bottom=8 /> />
  </SkiaScroll>
</SkiaLayer>
