// A body of text and braced values binds to a `string` content property as
// one string. Line breaks in the body are layout: they read as one space.

type Label = { content text:string }

let <Total count:int /> = <Label>Total: {count}</Label>

let <FullName first:string last:string /> =
  <Label>
    {first}
    {last}
  </Label>

let root() = {
  <Total count=3 />
  <FullName first="Ada" last="Lovelace" />
}
