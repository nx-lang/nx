import "@nx/graphics"
import "@nx/design"

// Colors, widths and radii come from the design tokens in @nx/design, so a theme restyles the
// drawing. The panel on the right sets env.colorMode to dark, and every token read inside it follows.

let accent: Paint = <Paint.color color={env.color.accent}/>
let outline: Stroke = <Stroke
  paint=<Paint.color color={env.color.text.normal}/>
  width={env.borderWidth.thick}
/>

<Drawing
  viewBox=<Rect x=0 y=0 width=400 height=240/>
  background=<Paint.color color={env.color.background}/>
>
  <RegularPolygon
    cx=55 cy=55
    radius=35
    pointCount=6
    fill={accent}
  />
  <Star
    cx=150 cy=55
    outerRadius=36 innerRadius=17
    pointCount=5
    rotation=-90
    fill={accent}
  />
  <Arrow
    x1=210 y1=55
    x2=285 y2=55
    shaftWidth=8
    headWidth=24 headLength=20
    fill={accent}
  />
  <Arc
    cx=340 cy=55
    radius=32
    startAngle=0 sweepAngle=270
    stroke={outline}
  />
  <RingSector
    cx=70 cy=160
    outerRadius=40 innerRadius=22
    sweepAngle=360
    fill={accent}
  />
  <Group opacity=0.5>
    <Rectangle x=140 y=130 width=60 height=60 fill={accent}/>
    <Circle cx=200 cy=160 r=30 fill={accent}/>
  </Group>
  <Group env.colorMode=dark>
    <Rectangle
      x=245 y=125
      width=145 height=70
      rx={env.radius.xl}
      fill=<Paint.color color={env.color.surface}/>
      stroke={outline}
    />
    <Circle cx=275 cy=160 r=15 fill={accent}/>
    <Text x=300 y=166 fontFamily="Fixture" fontSize={env.font.size.lg}>
      Dark
    </Text>
  </Group>
</Drawing>
