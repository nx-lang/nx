// Ported from the DrawnUI React demo's Uneven cells page.
//
// The original is a virtualized feed of rows with different heights: MeasureItemsStrategy is
// MeasureVisible, so visible cells are measured on demand and the rest estimated and refined in
// idle time. That is what this is too: the cell is an element function bound through ItemTemplate,
// and DrawnUI measures the visible rows out of the collection bound through ItemsSource.
//
// LoadMore at both ends and the jump toolbar are left out: both page or scroll the list from
// code-behind, which NX has no way to reach, so the feed is the original's first 200 posts.

type Post = {
  Id: int
  Title: string
  Body: string
  Footer: string
  Color: string
}

// The original draws random words; here a post's body and color follow from its number, so the
// rows still wrap to different heights and no two neighbors look alike.
let body(id:int): string = {
  if id % 5 is {
    0 => "Drawn ui renders every pixel itself."
    1 => "Skia canvas recycled cells measure visible estimates the rest and refines in idle time, so a row can be as tall as its text needs without costing a measure pass over the whole list."
    2 => "Uneven rows news feed social timeline product catalog."
    3 => "Drawn ui renders every pixel itself skia canvas recycled cells measure visible estimates the rest and refines in idle time uneven rows news feed social timeline product catalog drawn ui renders every pixel itself skia canvas recycled cells."
    else => "Measure visible estimates the rest."
  }
}
let color(id:int): string = {
  if id % 6 is {
    0 => "#0D6EFD"
    1 => "#6610F2"
    2 => "#D63384"
    3 => "#FD7E14"
    4 => "#20C997"
    else => "#0DCAF0"
  }
}
let post(id:int): Post = <Post Id={id} Title={"Post " + id} Body={body(id)} Footer={"#" + id + " · uneven row"} Color={color(id)} />

// The feed: the original's first 200 posts, counted out by a range.
let posts = { for id in 1..=200 { post(id) } }

// The cell the original builds imperatively in FeedCell: a colored stripe beside a column whose
// body text wraps to as many lines as it needs, so no two rows are the same height. An element
// function, so DrawnUI calls it once per cell it binds, with the item and its index.
let <FeedCell Item:Post Index:int />: DrawnNode =
  <SkiaLayout Type=Absolute Padding=<Thickness Left=16 Top=12 Right=16 Bottom=12 />
    BackgroundColor="#111827" UseCache=ImageDoubleBuffered
    HorizontalOptions=Fill>
    <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=3 /> WidthRequest=6
      VerticalOptions=Fill BackgroundColor={Item.Color} />
    <SkiaStack Margin=<Thickness Left=18 /> Spacing=6>
      <SkiaLabel Text={Item.Title} FontSize=15 FontFamily="FontTextBold" TextColor="#FFFFFF" />
      <SkiaLabel Text={Item.Body} FontSize=13 TextColor="#CBD5E1" HorizontalOptions=Fill />
      <SkiaLabel Text={Item.Footer} FontSize=11 TextColor="#64748B" />
    </SkiaStack>
  </SkiaLayout>

<SkiaLayer VerticalOptions=Fill>
  <SkiaLabel Text="200 uneven cells · MeasureVisible" FontSize=13 TextColor="#D3D3D3" HorizontalOptions=Center
    Margin=<Thickness Top=10 /> />
  <SkiaScroll Orientation=Vertical Margin=<Thickness Top=36 />>
    <SkiaStack TItem=Post ItemsSource={posts} ItemTemplate={FeedCell}
      RecyclingTemplate=Enabled MeasureItemsStrategy=MeasureVisible
      Spacing=8 Padding=<Thickness Left=16 Top=8 Right=16 Bottom=8 /> />
  </SkiaScroll>
</SkiaLayer>
