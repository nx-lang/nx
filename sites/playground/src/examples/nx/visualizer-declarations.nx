import "@nx/visualizer"

// Visualizer declarations say how a reader sees a type, not what it is.
// Switch to Read to see the reading follow them.

type Size = small | medium | large
type Swatch = string

type Drink = {
  name:string
  size:Size = medium
  iced:boolean = false
  color?:Swatch
}

visualizer Size =
  <UnionVisualizer>
    <CaseVisualizer of=small label="Small (8 oz)" />
    <CaseVisualizer of=medium label="Medium (12 oz)" />
    <CaseVisualizer of=large label="Large (16 oz)" />
  </UnionVisualizer>
visualizer Swatch = <ValueVisualizer format=color />
visualizer Drink =
  <ElementVisualizer title=name>
    <PropertyVisualizer of=iced whenTrue="Iced" whenFalse="Hot" />
  </ElementVisualizer>

let root(): Drink+ = {
  <Drink name="Latte" />
  <Drink name="Cold brew" size=large iced={true} color="#5a3a22" />
}
