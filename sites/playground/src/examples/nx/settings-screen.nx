// A workspace settings screen, the kind of page a XAML or JSX file holds. It has three parts: a
// small design system declared as external components, the data the screen shows, and the screen
// itself, a component whose state follows what the person changes before they save.

import "@nx/visualizer"

/// Text a person reads: a title, a label, a message. It is what a translator translates.
type uitext = string

type Tone = neutral | success | warning | danger
type ButtonKind = primary | secondary | destructive | link
type TextStyle = title | heading | body | caption
type Gap = none | small | medium | large

abstract external component <View />

external component <Page extends View title:uitext subtitle?:uitext content children:View+ />
external component <Section extends View title:uitext description?:uitext content children:View+ />
external component <Stack extends View gap:Gap = medium content children:View+ />
external component <Row extends View gap:Gap = small content children:View+ />
external component <Text extends View style:TextStyle = body tone:Tone = neutral content text:uitext />
external component <Badge extends View label:uitext tone:Tone = neutral />
external component <Avatar extends View name:string imageUrl?:string />
external component <Divider extends View />
external component <Banner extends View tone:Tone title:uitext body?:uitext />

external component <TextField extends View
  label:uitext
  value:string
  placeholder?:uitext
  help?:uitext
  error?:uitext
  emits { Changed { value:string } }
/>

external component <Toggle extends View
  label:uitext
  on:boolean
  help?:uitext
  emits { Toggled { on:boolean } }
/>

external component <Button extends View
  label:uitext
  kind:ButtonKind = secondary
  disabled:boolean = false
  emits { Tapped { } }
/>

type Plan = free | team | enterprise
type Role = owner | admin | member | guest

type Member = {
  name:string
  email:string
  role:Role
  lastSeen?:string
  twoFactor:boolean = false
}

type Workspace = {
  name:string
  slug:string
  plan:Plan
  seats:int
  seatsUsed:int
  members:Member+
}

visualizer Page = <ElementVisualizer title=title icon="app-window" />
visualizer Section = <ElementVisualizer title=title icon="panel-top" />
visualizer Stack = <ElementVisualizer icon="rows-3" />
visualizer Row = <ElementVisualizer icon="columns-3" />
visualizer Text = <ElementVisualizer icon="type">
  <PropertyVisualizer property=style label="Style" icon="heading" />
  <PropertyVisualizer property=tone label="Tone" icon="palette" />
</ElementVisualizer>
visualizer Badge = <ElementVisualizer title=label icon="badge">
  <PropertyVisualizer property=tone label="Tone" icon="palette" />
</ElementVisualizer>
visualizer Avatar = <ElementVisualizer title=name icon="circle-user-round">
  <PropertyVisualizer property=imageUrl label="Image" icon="image" />
</ElementVisualizer>
visualizer Banner = <ElementVisualizer title=title icon="megaphone">
  <PropertyVisualizer property=tone label="Tone" icon="palette" />
</ElementVisualizer>
visualizer TextField = <ElementVisualizer title=label icon="text-cursor-input">
  <PropertyVisualizer property=value label="Value" />
  <PropertyVisualizer property=placeholder label="Placeholder" />
  <PropertyVisualizer property=help label="Help" icon="circle-help" />
  <PropertyVisualizer property=error label="Error" icon="circle-alert" />
</ElementVisualizer>
visualizer Toggle = <ElementVisualizer title=label icon="toggle-right">
  <PropertyVisualizer property=on label="On" />
  <PropertyVisualizer property=help label="Help" icon="circle-help" />
</ElementVisualizer>
visualizer Button = <ElementVisualizer title=label icon="mouse-pointer-click">
  <PropertyVisualizer property=kind label="Kind" icon="shapes" />
  <PropertyVisualizer property=disabled label="Disabled" />
</ElementVisualizer>
visualizer Divider = <ElementVisualizer icon="minus" />
visualizer Workspace = <ElementVisualizer title=name id=slug icon="building">
  <PropertyVisualizer property=plan label="Plan" icon="credit-card" />
  <PropertyVisualizer property=seats label="Seats" icon="armchair" />
  <PropertyVisualizer property=seatsUsed label="Seats used" icon="users" />
</ElementVisualizer>
visualizer Member = <ElementVisualizer title=name icon="user-round">
  <PropertyVisualizer property=email label="Email" icon="mail" />
  <PropertyVisualizer property=role label="Role" icon="shield" />
  <PropertyVisualizer property=lastSeen label="Last seen" icon="clock" />
  <PropertyVisualizer property=twoFactor label="Two-factor" />
</ElementVisualizer>

action Saved = { name:string slug:string requireTwoFactor:boolean }
action MemberRemoved = { email:string }

let workspace =
  <Workspace
    name="Hive5 Tools"
    slug="hive5-tools"
    plan=team
    seats=5
    seatsUsed=5
    members={
      <Member name="Ada Lovelace" email="ada@example.com" role=owner lastSeen="Today" twoFactor={true} />
      <Member name="Grace Hopper" email="grace@example.com" role=admin lastSeen="Yesterday" twoFactor={true} />
      <Member name="Barbara Liskov" email="barbara@example.com" role=member lastSeen="3 days ago" />
      <Member name="Margaret Hamilton" email="margaret@example.com" role=member twoFactor={true} />
      <Member name="Katherine Johnson" email="katherine@example.com" role=guest lastSeen="Last month" />
    }
  />

let roleLabel(role:Role): uitext = {
  if role is {
    Role.owner => "Owner"
    Role.admin => "Admin"
    Role.member => "Member"
    Role.guest => "Guest"
  }
}

let roleTone(role:Role): Tone = {
  if role is {
    Role.owner => Tone.success
    Role.admin => Tone.warning
    else => Tone.neutral
  }
}

let planSummary(plan:Plan, seats:int, used:int): uitext = {
  if plan is {
    Plan.free => "Free plan, up to 3 people"
    Plan.team => "Team plan, " + used + " of " + seats + " seats in use"
    Plan.enterprise => "Enterprise plan, unlimited seats"
  }
}

/// One person in the members list, with what an admin can do to them.
let <MemberRow member:Member canRemove:boolean /> =
  <Row gap=medium>
    <Avatar name={member.name} />
    <Stack gap=none>
      <Text>{member.name}</Text>
      <Text style=caption>{member.email}</Text>
    </Stack>
    <Badge label={roleLabel(member.role)} tone={roleTone(member.role)} />
    if !member.twoFactor {
      <Badge label="No two-factor" tone=danger />
    }
    <Text style=caption>{member.lastSeen ?? "Never signed in"}</Text>
    if canRemove {
      <Button label="Remove" kind=destructive onTapped=<MemberRemoved email={member.email} /> />
    }
  </Row>

component <WorkspaceSettings workspace:Workspace emits { Saved MemberRemoved } /> = {
  state {
    name:string = {workspace.name}
    slug:string = {workspace.slug}
    requireTwoFactor:boolean = false
    confirmingDelete:boolean = false
  }

  <Page title="Workspace settings" subtitle={planSummary(workspace.plan, workspace.seats, workspace.seatsUsed)}>
    if workspace.plan == Plan.team && workspace.seatsUsed >= workspace.seats {
      <Banner tone=warning title="Every seat is in use" body="Add seats before you invite anyone else." />
    }

    <Section title="General" description="How this workspace appears to the people in it.">
      <TextField
        label="Name"
        value={name}
        placeholder="Your team or company"
        error={if name == "" { "A workspace needs a name" }}
        onChanged=<State.Update name={action.value} />
      />
      <TextField
        label="Web address"
        value={slug}
        help={"hive5.example.com/" + slug}
        onChanged=<State.Update slug={action.value} />
      />
    </Section>

    <Section title="Security">
      <Toggle
        label="Require two-factor sign-in"
        on={requireTwoFactor}
        help="People without it are asked to set it up the next time they sign in."
        onToggled=<State.Update requireTwoFactor={action.on} />
      />
      if requireTwoFactor {
        <Banner
          tone=neutral
          title="Some people will be asked to set up two-factor"
          body="They do it the next time they sign in. Nobody is signed out."
        />
      }
    </Section>

    <Section title="Members" description="Everyone who can open this workspace.">
      <Stack gap=small>
        for member in workspace.members {
          <MemberRow member={member} canRemove={member.role != Role.owner} />
          if requireTwoFactor && !member.twoFactor {
            <Text style=caption>Asked to set up two-factor at next sign-in</Text>
          }
        }
      </Stack>
      <Button label="Invite people" kind=primary />
    </Section>

    <Divider />

    <Row>
      <Button
        label="Save changes"
        kind=primary
        disabled={name == ""}
        onTapped=<Saved name={name} slug={slug} requireTwoFactor={requireTwoFactor} />
      />
      if confirmingDelete {
        <Text tone=danger>This deletes the workspace for everyone.</Text>
        <Button label="Yes, delete it" kind=destructive />
        <Button label="Cancel" kind=link onTapped=<State.Update confirmingDelete={false} /> />
      } else {
        <Button label="Delete workspace" kind=destructive onTapped=<State.Update confirmingDelete={true} /> />
      }
    </Row>
  </Page>
}

<WorkspaceSettings workspace={workspace} />
