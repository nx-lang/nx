// Ported from the DrawnUI React demo's Images page.
//
// SkiaImage: one source in every TransformAspect, then the effects, custom filters, SkiaImageTiles,
// the preload queue, and alignment inside the box. The aspect row is written as a loop over a list
// of records — the original maps over an array.
//
// Three of the original's cards are built in code. The custom-filter card hands CanvasKit filter
// objects to PaintColorFilter and PaintImageFilter (code-behind); those hosts draw plain here. The
// tile card animates TileOffsetX from a timer (animation); here the offset is fixed. The preload
// card drives SkiaImageManager from a button and reports the queue (event handlers); the button is
// drawn and does nothing.

type AspectDemo = {
  Aspect: TransformAspect
  Title: string
}

component <AspectTile extends DrawnNode Demo:AspectDemo /> = {
  <SkiaStack Spacing=4 WidthRequest=220>
    <SkiaImage Source="images/baboon.jpg" WidthRequest=220 HeightRequest=120
      Aspect={Demo.Aspect} BackgroundColor="#000000" />
    <SkiaLabel Text={Demo.Title} FontSize=15 TextColor="#FFFFFF" />
  </SkiaStack>
}

// A captioned tile for the effect grid, where each image sets different properties.
component <Tile extends DrawnNode Title:string content Children:DrawnNode[] /> = {
  <SkiaStack Spacing=4 WidthRequest=160>
    {Children}
    <SkiaLabel Text={Title} FontSize=12 TextColor="#94A3B8" />
  </SkiaStack>
}

component <Heading extends DrawnNode Text:string /> = {
  <SkiaLabel Text={Text} FontSize=20 TextColor="#FFFFFF"
    HorizontalOptions=Center Margin=<Thickness Top=12 /> />
}

let aspects = {
  <AspectDemo Aspect=AspectCover Title="AspectCover" />
  <AspectDemo Aspect=AspectFit Title="AspectFit" />
  <AspectDemo Aspect=AspectFill Title="AspectFill" />
  <AspectDemo Aspect=AspectFitFill Title="AspectFitFill" />
  <AspectDemo Aspect=Fill Title="Fill" />
  <AspectDemo Aspect=Fit Title="Fit" />
  <AspectDemo Aspect=FitFill Title="FitFill" />
  <AspectDemo Aspect=Cover Title="Cover" />
  <AspectDemo Aspect=None Title="None" />
}

<SkiaScroll Orientation=Vertical>
  <SkiaStack Padding=<Thickness Left=16 Top=16 Right=16 Bottom=16 /> Spacing=16>
    <SkiaLabel Text="SkiaImage · Aspect" FontSize=24 TextColor="#FFFFFF" HorizontalOptions=Center />
    <SkiaLabel Text="Same 512x512 photo in a 220x120 box. Overflow is clipped to the box."
      FontSize=13 TextColor="#D3D3D3" HorizontalOptions=Center />
    <SkiaWrap Spacing=16 HorizontalOptions=Center MaximumWidthRequest=720>
      for demo in aspects {
        <AspectTile Demo={demo} />
      }
    </SkiaWrap>

    <Heading Text="Effects · AddEffect, Blur, Zoom, offsets" />
    <SkiaWrap Spacing=16 HorizontalOptions=Center MaximumWidthRequest=720>
      <Tile Title="BlackAndWhite">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=BlackAndWhite />
      </Tile>
      <Tile Title="Sepia">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Sepia />
      </Tile>
      <Tile Title="Pastel">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Pastel />
      </Tile>
      <Tile Title="InvertColors">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=InvertColors />
      </Tile>
      <Tile Title="Tint #0D6EFD Multiply">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Tint ColorTint="#0D6EFD" EffectBlendMode=Multiply />
      </Tile>
      <Tile Title="Darken={80}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Darken Darken=80 />
      </Tile>
      <Tile Title="Lighten={80}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Lighten Lighten=80 />
      </Tile>
      <Tile Title="Contrast={1.5}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Contrast Contrast=1.5 />
      </Tile>
      <Tile Title="Saturation={2}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" AddEffect=Saturation Saturation=2 />
      </Tile>
      <Tile Title="Blur={3}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" Blur=3 />
      </Tile>
      <Tile Title="ZoomX/Y={1.8}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" ZoomX=1.8 ZoomY=1.8 />
      </Tile>
      <Tile Title="HorizontalOffset={-40}">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#000000" HorizontalOffset=-40 Aspect=AspectFit />
      </Tile>
      <Tile Title="HSL Gamma=0.6 (hue) Sat=1 Bright=0.5">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100
          BackgroundColor="#FFFFFF" AddEffect=HSL Gamma=0.6 Saturation=1 Brightness=0.5 />
      </Tile>
    </SkiaWrap>

    <Heading Text="Custom filters · AddEffect=Custom + PaintColorFilter / PaintImageFilter" />
    // The original builds a CanvasKit ColorFilter (a red/blue channel swap) and an ImageFilter
    // (MakeDilate) in code and assigns them here. The catalog has no way to spell an engine object,
    // so both images draw unfiltered.
    <SkiaWrap Spacing=16 HorizontalOptions=Center MaximumWidthRequest=720>
      <Tile Title="PaintColorFilter = MakeMatrix (R↔B) — code-behind, drawn plain">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100 AddEffect=Custom />
      </Tile>
      <Tile Title="PaintImageFilter = MakeDilate(4) — code-behind, drawn plain">
        <SkiaImage Source="images/baboon.jpg" WidthRequest=160 HeightRequest=100 />
      </Tile>
    </SkiaWrap>

    <Heading Text="SkiaImageTiles · TileWidth/TileHeight, TileOffsetX animates in the original" />
    <SkiaImageTiles Source="images/baboon.jpg" TileWidth=64 TileHeight=64 TileOffsetX=40 TileOffsetY=20
      HorizontalOptions=Center WidthRequest=400 HeightRequest=160 BackgroundColor="#000000" />

    <Heading Text="SkiaImageManager preload queue · idle" />
    // The original's button preloads eight urls through the priority queue and reports how many
    // were in flight; without event handlers it is drawn and does nothing.
    <SkiaButton Text="PreloadImages(8 urls, Low)" BackgroundColor="#0D6EFD" FontSize=13 HorizontalOptions=Center />

    <Heading Text="Alignment inside the box" />
    <SkiaWrap Spacing=16 HorizontalOptions=Center MaximumWidthRequest=720>
      <SkiaImage Source="images/baboon.jpg" WidthRequest=120 HeightRequest=120 Aspect=AspectFit
        HorizontalAlignment=Start VerticalAlignment=Start BackgroundColor="#000000" />
      <SkiaImage Source="images/baboon.jpg" WidthRequest=120 HeightRequest=120 Aspect=Fit
        HorizontalAlignment=Center VerticalAlignment=Center BackgroundColor="#000000" />
      <SkiaImage Source="images/baboon.jpg" WidthRequest=120 HeightRequest=120 Aspect=Fit
        HorizontalAlignment=End VerticalAlignment=End BackgroundColor="#000000" />
    </SkiaWrap>
  </SkiaStack>
</SkiaScroll>
