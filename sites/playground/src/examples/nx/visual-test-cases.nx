import "@nx/visualizer"

// Test cases for Visual, one or two of each. Hover a name for its doc. Click a value to edit it,
// Enter or F2 to edit the selected row, Escape to cancel, Delete to leave out a property that has a
// default or is optional, and Ctrl+Z to undo. After each edit, check Source.

/// Text a person reads.
type uitext = string
/// A color, as CSS writes one.
type Color = string
type Count = int

/// How big a cup is.
type Size =
  /// 8 oz
  | small
  /// 12 oz, the usual
  | medium
  /// 16 oz
  | large

/// Something on the menu.
abstract type Item = {
  code:string
  name:uitext
  note?:uitext
}

type Drink extends Item = {
  size:Size = medium
  iced:boolean = false
  shots:Count = 1
  price:float64 = 4.5
  color?:Color
  ratings?:int+
}

type Pastry extends Item = {
  warm:boolean = false
  pairsWith?:string
}

type Note = { content text:uitext }
type Menu = { title:uitext content items:Item+ }

visualizer Color = <ValueVisualizer format=color />
visualizer Item = <ElementVisualizer title=name id=code icon="coffee" />
visualizer Pastry =
  <ElementVisualizer title=name id=code idPosition=end icon="croissant">
    <PropertyVisualizer property=pairsWith format=id />
  </ElementVisualizer>
visualizer Menu = <ElementVisualizer title=title icon="book-open" />

// Values: a number, an untyped number, a string with escapes, and one with \n (it opens in Source)
let total = 3
let ratio = 1.5
let greeting = "Say \"hi\" \\ bye"
let lines = "one\ntwo"

// Text content: each run edits as one line; the space before {total} stays
let welcome = <Note>Welcome back</Note>
let note = <Note>Ask for oat milk {total} times</Note>

// Functions: a value from one is not edited here; one used as an element reads with its own icon
let priceOf(size:Size): float64 = { if size == Size.large { 5.5 } else { 4.5 } }
let <Special name:uitext /> = <Drink code="SPC" name={name} size=large />
let sizes:Size+ = { Size.small Size.large }

let root(): Menu = {
  <Menu title="Morning menu">
    // One line: Tab through its values; a case opens a popover of cases with their docs
    <Drink code="LAT" name="Latte" size=small iced=false shots=2 />
    // A sheet: Delete leaves out size, iced, color (and its comment) or note, but not name; ratings
    // takes no negative number; double-click total + 1 to open it in Source
    <Drink
      code="CBR"
      name="Cold brew"
      size=large
      iced={true}
      shots={total + 1}
      price=5.25
      color="#5a3a22" // leaves with color
      note="Say \"hi\" \\ bye"
      ratings={ 4 2 5 }
    />
    // Its own visualizer: the id reads last, and pairsWith as an id
    <Pastry code="CRO" name="Croissant" warm={true} pairsWith="LAT" />
    <Special name="Flat white" />
    // Built from data: for and if read as written
    for size in sizes {
      if size != Size.small {
        <Drink code="ESP" name="Espresso" size={size} price={priceOf(size)} />
      }
    }
  </Menu>
}
