import "@nx/visualizer"

// Test cases for Visual, one or two of each. Hover a name, or select it and press i, for its card.
// Click a value, or press Enter or F2 on the selected row, to edit it; Tab and Shift+Tab move between
// values and Escape cancels. Delete (Cmd+Backspace on a Mac) leaves out a property that has a default
// or is optional, and so does Reset to default or Remove in a row's menu (the ⋯ at its end, or Shift+F10).
// Select an element to see "Show N unset properties", the properties it does not write: open it and
// set one; an optional one reads its type until set. Ctrl or Cmd+Z and Shift+Z, or the title bar's
// buttons, undo and redo. After each edit, check Source. The survey further down has lists to
// reorder and delete from.

type uitext = string
type Color = string
type Code = string
type Count = int

/// How big a cup is.
type Size =
  /// 8 oz
  | small
  /// 12 oz, the usual
  | medium
  /// 16 oz
  | large

type Extra = none | syrup { flavor:uitext pumps:Count = 1 }
type Cup = { sleeve?:string lid:boolean = true }

abstract type Item = {
  code:Code
  name:uitext
  note?:uitext
}

/// A drink, hot or iced.
type Drink extends Item = {
  size:Size = medium
  iced:boolean = false
  /// Shots of espresso.
  shots:Count = 1
  price:float64 = 4.5
  color?:Color
  ratings?:int+
  cup?:Cup
  extra?:Extra
}

type Pastry extends Item = {
  warm:boolean = false
  pairsWith?:Code
}

type Water extends Item = { sparkling:boolean = false }

/// Space between things, in pixels.
type Spacing = int
/// A text size, in pixels, on the brand's scale.
type FontSize = int
type Align = start | center | end

type Banner = {
  title:uitext
  intro?:uitext
  /// Room inside the banner's edge.
  padding:Spacing = 8
  gap:int = 4
  /// How big the title reads.
  titleSize:FontSize = 16
  align:Align = start
  badge?:uitext
  body?:uitext
  tint?:Color
  cup?:Cup
}
type Note = { content text:uitext }
type Menu = { title:uitext content items:Item+ }

visualizer Color = <ValueVisualizer format=color />
visualizer Code = <ValueVisualizer format=id />
visualizer Item = <ElementVisualizer title=name id=code icon="coffee" />
visualizer Pastry = <ElementVisualizer idPosition=end icon="croissant" />
visualizer Water = <ElementVisualizer icon="no-such-icon" />
visualizer Cup = <ElementVisualizer><PropertyVisualizer property=sleeve format=color /></ElementVisualizer>
visualizer Spacing = <ValueVisualizer min=0 max=64 />
visualizer FontSize = <ValueVisualizer min=8 max=96>
  <ValueChoice value=12 label="sm" />
  <ValueChoice value=16 label="base" />
  <ValueChoice value=20 label="lg" />
  <ValueChoice value=28 label="xl" />
</ValueVisualizer>
visualizer Banner = <ElementVisualizer icon="panel-top">
  <PropertyVisualizer property=gap min=0 max=24 />
  <PropertyVisualizer property=align editor=segmented />
  <PropertyVisualizer property=badge>
    <ValueChoice value="New" />
    <ValueChoice value="Seasonal" />
    <ValueChoice value="Sold out" />
  </PropertyVisualizer>
  <PropertyVisualizer property=body multiline=true placeholder="A line or two for the banner" />
</ElementVisualizer>

/// The brand's warm accent.
let accent:Color = "#c8a27a"

// Hints: padding refuses 80 with "At most 64"; hover its value for steppers (click, Shift+click for
// 10, or drag up and down), and gap's stay within 0 to 24. titleSize has choices: hover it for
// steppers and a chevron, or open it and press Alt+Down, click the chevron, or type (try "lg" or 2)
// to list them, with Default 16 on top; pick one, or type 17, which is no choice and still commits.
// align is a row of buttons. tint is a reference to a named value: it opens Source. intro was written
// over two lines and edits with Shift+Enter for a line break. Select the banner and open "Show 3
// unset properties":
// badge lists its choices in one column, body is multi-line with a placeholder (Enter breaks a line,
// Ctrl or Cmd+Enter commits), and cup has no editor, so it opens Source.
let banner =
  <Banner
    title="Fresh today"
    intro="Pastries from the bakery next door.
Ask what came in this morning."
    padding=8
    gap=4
    titleSize=20
    align=start
    tint={accent}
  />

// On one line: rest the pointer on titleSize, or open it; its steppers and chevron take room in the
// line, pushing align right until they go. Passing over it moves nothing; selected, they show at
// once. badge's chevron takes room before the closing />.
// Click a stepper a few times: each click steps, and the selection stays.
let strip = <Banner title="Fresh" titleSize=20 align=start badge="New" />

// Values: an untyped int and float; a string with escapes, which opens without them; and one with \n,
// which Enter or a double-click opens in Source
let total = 3
let ratio = 1.5
let greeting = "Say \"hi\" \\ bye"
let lines = "one\ntwo"

// Text content: each run edits as one line, and the space before {total} stays. Typing a < b is
// refused, and the run over two lines does not edit.
let welcome = <Note>Welcome back</Note>
let note = <Note>Ask for oat milk {total} times</Note>
let poem = <Note>Two lines
  of text</Note>
// A union case on its own line: the tag icon
let promo =
  <Extra.syrup flavor="mocha" />

// Functions: priceOf's values are code and do not edit, but the literals Special's body writes do;
// its {name} is a parameter, so it opens Source. Special used as an element reads
// with the function icon.
let priceOf(size:Size): float64 = { if size == Size.large { 5.5 } else { 4.5 } }
let <Special name:uitext /> = <Drink code="SPC" name={name} size=large />
// A qualified case edits as a case and keeps its Size.
let sizes:Size+ = { Size.small Size.large }

// Lists to reorder and delete from. Drag a step by its icon or its name: a line shows where it
// lands, Escape cancels, and the reading scrolls near its top and bottom. Or select a step and press
// Alt+Up or Alt+Down, or use Move up and Move down in its ⋯ menu (Shift+F10). Delete or
// Cmd+Backspace deletes the selected step. Fold the welcome, then move a step past it: the fold
// stays on the welcome. The comment above "drink" moves with it; the step inside the if does not
// move, but the if does. Undo takes each back; check Source after each.
type Option = { value:Code label:uitext }
abstract type Step = { id:Code }
type Statement extends Step = { headline:uitext body?:uitext }
type Choose extends Step = { label:uitext options:Option+ }
type Ask extends Step = { label:uitext placeholder?:uitext }
type Flow = { title:uitext content steps:Step+ }

visualizer Statement = <ElementVisualizer title=headline id=id icon="message-square" />
visualizer Choose = <ElementVisualizer title=label id=id icon="circle-dot" />
visualizer Ask = <ElementVisualizer title=label id=id icon="text-cursor-input" />
visualizer Option = <ElementVisualizer title=label id=value icon="circle" />

let wantsMilk = true

// drink's options are written an option to a line, and drag too; size's are on one line, so they
// move by Alt+Up and Alt+Down and the menu only.
let survey =
  <Flow title="Morning survey">
    <Statement
      id="welcome"
      headline="Good morning"
      body="Three quick questions about your coffee."
    />
    // Ask this first
    <Choose
      id="drink"
      label="What do you drink?"
      options={
        <Option value="latte" label="Latte" />
        <Option value="mocha" label="Mocha" />
        <Option value="tea" label="Tea" />
      }
    />
    <Ask id="name" label="Your name?" />
    if wantsMilk {
      <Ask id="milk" label="Which milk?" />
    }
    <Choose id="size" label="Which size?" options={ <Option value="s" label="Small" /> <Option value="l" label="Large" /> } />
  </Flow>

// A list of one step: it has nothing to drag past, and as the only step of a Flow, whose steps are
// Step+, it cannot be deleted.
let short =
  <Flow title="One question">
    <Ask id="else" label="Anything else?" />
  </Flow>

let root(): Menu = {
  // No visualizer: the box icon, and folded (its chevron, or Left) it counts its children
  <Menu title="Morning menu">
    // One line: Space or a click toggles iced; Up and Down step shots, Shift by 10, or drag its name;
    // 12px is not a number; size opens a popover of cases with their docs, and edits right after an
    // emoji
    <Drink code="LAT" name="☕ Latte" size=small iced=false shots=2 />
    // A sheet: Delete leaves out size, iced, color (and its comment), note, cup or extra, but not
    // name; iced keeps its braces; price is a float64; color and cup's sleeve open a hex field and a
    // picker; ratings takes no negative number; double-click total + 1 to open it in Source
    <Drink
      code="CBR"
      name="Cold brew"
      size=large
      iced={true}
      shots={total + 1}
      price=5.25
      color="#5a3a22" // leaves with color
      note="Say \"hi\" \\ bye"
      ratings={ 4 2 5 }
      cup=<Cup sleeve="#c8a27a" lid=false />
      extra=<Extra.syrup flavor="caramel" pumps=2 />
    />
    // Item's visualizer, merged: the id reads last, and pairsWith, a Code, as an id
    <Pastry code="CRO" name="Croissant" warm={true} pairsWith="LAT" />
    // An icon Visual cannot draw gives way to the box
    <Water code="H2O" name="Water" />
    <Special name="Flat white" />
    // Built from data: for and if read as written
    for size in sizes {
      if size != Size.small {
        <Drink code="ESP" name="Espresso" size={size} price={priceOf(size)} />
      }
    }
  </Menu>
}
