# Cache policy for the playground's static files, read by Cloudflare's static assets.
#
# Vite names everything under assets/ by content hash, so a build changes the names and the old
# ones can be held forever. The shell names them, so it is revalidated on every use. Fonts, images
# and the other public files keep their names across builds and are held for a day at most.

/playground/assets/*
  Cache-Control: public, max-age=31536000, immutable

/playground/fonts/*
  Cache-Control: public, max-age=86400, must-revalidate

/playground/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/playground/anims/*
  Cache-Control: public, max-age=86400, must-revalidate

/playground/lottie/*
  Cache-Control: public, max-age=86400, must-revalidate

/playground/shaders/*
  Cache-Control: public, max-age=86400, must-revalidate

/playground/index.html
  Cache-Control: no-cache
