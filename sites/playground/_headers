# Cache policy for the playground's static files, read by Cloudflare's static assets.
#
# Vite names everything under assets/ by content hash, so a build changes the names and the old
# ones can be held forever. The shell names them, so it is revalidated on every use.

/play/assets/*
  Cache-Control: public, max-age=31536000, immutable

/play/index.html
  Cache-Control: no-cache
