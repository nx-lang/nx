// The website's Cloudflare Worker: the static files under dist/, with no script. The playground's
// Worker claims the more specific /playground routes, so this one serves the rest of the domain.
// Deployed by .github/workflows/deploy-website.yml; setup is in docs/deployment-setup.md.
{
  "name": "nxlang-website",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "nxlang.org/*", "zone_name": "nxlang.org" }],
  "workers_dev": true
}
