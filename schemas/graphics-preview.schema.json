{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unstable graphics-core-v3 preview manifest or failure",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "revision",
        "profile",
        "renderer",
        "image",
        "diagnostics",
        "scene"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "const": "graphics-core-v3"
        },
        "renderer": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        },
        "scene": {
          "type": "object",
          "required": [
            "revision",
            "profile",
            "config",
            "root"
          ],
          "properties": {
            "revision": {
              "type": "string"
            },
            "profile": {
              "const": "graphics-core-v3"
            },
            "config": {
              "type": "object",
              "required": [
                "width",
                "height",
                "scale",
                "program_revision",
                "graphics_version",
                "renderer",
                "fonts",
                "limits"
              ]
            },
            "root": {
              "$ref": "#/$defs/node"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "status",
        "requestRevision",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "requestRevision": {
          "type": "string"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "bounds": {
      "type": "object",
      "required": [
        "rect",
        "conservative"
      ],
      "properties": {
        "rect": {
          "type": [
            "object",
            "null"
          ]
        },
        "conservative": {
          "type": "boolean"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "parent",
        "order",
        "identity",
        "provenance",
        "geometry",
        "painted",
        "visible",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "identity": {
          "type": "object",
          "required": [
            "module",
            "version",
            "declaration"
          ]
        },
        "geometry": {
          "$ref": "#/$defs/bounds"
        },
        "painted": {
          "$ref": "#/$defs/bounds"
        },
        "visible": {
          "$ref": "#/$defs/bounds"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "fill": {
          "$ref": "#/$defs/paint"
        },
        "stroke": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "paint",
                "width"
              ],
              "properties": {
                "paint": {
                  "$ref": "#/$defs/paint"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
    "paint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "kind",
            "color"
          ],
          "properties": {
            "kind": {
              "const": "color"
            },
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "x1",
            "y1",
            "x2",
            "y2",
            "stops"
          ],
          "properties": {
            "kind": {
              "const": "linearGradient"
            },
            "x1": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            },
            "stops": {
              "$ref": "#/$defs/stops"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "cx",
            "cy",
            "radius",
            "stops"
          ],
          "properties": {
            "kind": {
              "const": "radialGradient"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stops": {
              "$ref": "#/$defs/stops"
            }
          }
        }
      ]
    },
    "color": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "offset",
          "color"
        ],
        "properties": {
          "offset": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "$ref": "#/$defs/color"
          }
        }
      }
    }
  }
}
