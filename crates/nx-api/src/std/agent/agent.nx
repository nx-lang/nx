// The NX agent library: product-neutral types for declaring an AI agent, its reference documents
// and its tools. Import it with `import "@nx/agent"`.
//
// UNSTABLE. These declarations may change incompatibly in any NX release, including a patch
// release. See https://nxlang.org/reference/libraries/agent.
//
// The library holds types only. What a tool does, how its schemas are derived and how a run
// proceeds are the host's business.

/// Limits on one run of an agent. A host applies its own caps as well, and the lower value wins.
export type AgentLimits = {
  maxSteps?: int      /// The most model calls one run may make.
  maxToolCalls?: int  /// The most tool calls one run may make.
}

/// Reference text sent to the model on every run, kept separate from the agent's instructions.
export type Document = {
  title: string         /// Names the document in traces and citations. Unique among one agent's documents.
  content text: string  /// The document's text, written as the element body.
}

/// Something the model can call during a run. Each concrete tool type says what the call does.
export abstract type Tool = {
  name?: string         /// The model-facing name, in snake_case. Each tool type has a default.
  description?: string  /// The model-facing description. Each tool type has a default.
}

/// A reusable definition of an agent: who answers, with what reference text and which tools.
export type Agent = {
  name: string                  /// A stable identifier for the agent, shown in traces.
  description?: string          /// What the agent is for. Shown to operators and not sent to the model.
  model?: string                /// The model to run. NX does not interpret it; the host resolves it and may restrict
                                /// it.
  documents?: Document+         /// Reference text sent to the model on every run, after the instructions.
  tools?: Tool+                 /// The tools the model may call.
  limits?: AgentLimits          /// Limits on one run.
  content instructions: string  /// How the agent behaves: the system prompt, written as the element body.
}

/// Exposes an NX function to the model. The tool's input schema comes from the function's
/// parameters and its output schema from the function's result type.
export type FunctionTool extends Tool = {
  function: <function ... />: object*  /// The function the tool calls. Its name and doc comment are the tool's default
                                       /// name and description.
}

/// Web search run by the model provider. The default name is `web_search`.
export type WebSearchTool extends Tool = {
  allowedDomains?: string+  /// The only domains the search may draw on. Without it the search is unrestricted.
}

/// Values the host supplies to a tool's function. A function parameter of this type, or of a type
/// that extends it, is filled in by the host and left out of the tool's input schema, so the model
/// never supplies it. A host extends this type with the values it provides.
export abstract type ToolContext = {
  callId: string  /// Identifies this tool call and stays the same when the call is retried, so it can serve as an
                  /// idempotency key.
}

/// The method of an HTTP request.
export type HttpMethod = get | post | put | patch | delete

/// An external service a tool can reach. The model never sees a connection's address.
export abstract type Connection = {
  name: string          /// Identifies the connection in traces.
  description?: string  /// What the service is. Shown to operators and not sent to the model.
}

/// A service reached over HTTPS.
export type HttpConnection extends Connection = {
  baseUrl: string  /// The URL every request to the service starts with. It must use `https`.
}

/// One named value of an HTTP request. The host encodes the value.
export type HttpParam = {
  name: string   /// The parameter's name.
  value: string  /// The parameter's value, not encoded.
}

/// The variable parts of one HTTP call, returned by an [HttpTool]'s `arguments` function.
export type HttpArguments = {
  pathParams?: HttpParam+  /// Values for the `{name}` placeholders in the tool's path.
  query?: HttpParam+       /// Query string parameters, in order.
  body?: object            /// The request body, which the host sends as JSON. Usually a record the program declares.
}

/// One operation on a connection: a fixed method and path. Only the arguments vary per call.
export type HttpTool extends Tool = {
  connection: HttpConnection     /// The service the tool calls.
  method: HttpMethod             /// The request method. `get` makes the tool read-only; any other method is a write.
  path: string                   /// The path under the connection's base URL. It may hold `{name}` placeholders.

  /// A function that returns the call's [HttpArguments]. Its parameters are the tool's input
  /// schema, and its name and doc comment are the tool's default name and description.
  arguments: <function ... />: HttpArguments
  maxCallsPerConversation?: int  /// Maximum calls to this tool per conversation. A host may impose a lower cap.
}
