// Unstable renderer-independent color standard library.

/// Encoded non-premultiplied sRGB channels and alpha, each in [0, 1].
export type Color = {
  r: float32      /// Encoded red in [0, 1].
  g: float32      /// Encoded green in [0, 1].
  b: float32      /// Encoded blue in [0, 1].
  a: float32 = 1  /// Alpha in [0, 1]; 0 is transparent and 1 is opaque.
}

/// Recoverable parsing result.
export type ParseResult =
  | parsed { value: Color }
  | invalid { message: string }

/// Rectangular interpolation space.
export type InterpolationSpace = srgb | linearSrgb | oklab

/// Encoded sRGB channels in [0, 255]; alpha is in [0, 1].
export type RgbChannels = {
  r: float64      /// Red in [0, 255].
  g: float64      /// Green in [0, 255].
  b: float64      /// Blue in [0, 255].
  alpha: float64  /// Alpha in [0, 1].
}

/// Numerical Hsl channels; alpha is in [0, 1].
export type HslChannels = {
  h: float64      /// Hue in degrees, in [0, 360).
  s: float64      /// Saturation in [0, 1].
  l: float64      /// Lightness in [0, 1].
  alpha: float64  /// Alpha in [0, 1].
}

/// Numerical Hsv channels; alpha is in [0, 1].
export type HsvChannels = {
  h: float64      /// Hue in degrees, in [0, 360).
  s: float64      /// Saturation in [0, 1].
  v: float64      /// Value in [0, 1].
  alpha: float64  /// Alpha in [0, 1].
}

/// Numerical Hwb channels; alpha is in [0, 1].
export type HwbChannels = {
  h: float64      /// Hue in degrees, in [0, 360).
  w: float64      /// Whiteness in [0, 1].
  b: float64      /// Blackness in [0, 1].
  alpha: float64  /// Alpha in [0, 1].
}

/// Numerical LinearRgb channels; alpha is in [0, 1].
export type LinearRgbChannels = {
  r: float64      /// Linear-light red in [0, 1].
  g: float64      /// Linear-light green in [0, 1].
  b: float64      /// Linear-light blue in [0, 1].
  alpha: float64  /// Alpha in [0, 1].
}

/// Numerical Oklab channels; alpha is in [0, 1].
export type OklabChannels = {
  l: float64      /// Lightness in [0, 1].
  a: float64      /// Green-red opponent channel.
  b: float64      /// Blue-yellow opponent channel.
  alpha: float64  /// Alpha in [0, 1].
}

/// Numerical Oklch channels; alpha is in [0, 1].
export type OklchChannels = {
  l: float64      /// Lightness in [0, 1].
  c: float64      /// Nonnegative chroma.
  h: float64      /// Hue in degrees, in [0, 360).
  alpha: float64  /// Alpha in [0, 1].
}

