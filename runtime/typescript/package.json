{
  "name": "@nx-lang/ir-runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Evaluates persisted NX IR JSON in JavaScript: prepare a program, run its functions and components, and apply record updates.",
  "license": "MIT",
  "homepage": "https://nx-lang.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-lang/nx.git",
    "directory": "runtime/typescript"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node dist/test/runtime.test.js && node test/emitted-ir.test.mjs",
    "prepack": "pnpm run build",
    "verify:package": "node ../../scripts/verify-package.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
