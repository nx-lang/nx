// Type aliases
type UserId = int
type Username = string
type MaybeUser = User?
type UserList = UserBase[]
type EntityList = Entity[]

// A closed set of constants is a union whose cases carry no payload
type CardSortMode = open | closed
type DealStage =
  | draft
  | pending_review
  | closed_won

// Records
abstract type Entity = {
  id: UserId
}

abstract type UserBase extends Entity = {
  name: Username
  email: string?
  age: int = 18
}

type User extends UserBase = {
  isAdmin: boolean = false
}

type StaffUser extends UserBase = {
  department: string
}

type UserCard = {
  user: UserBase
}

// Discriminated unions model states with optional per-case payloads
type LoadState =
  | idle
  | loading
  | failed { message:string retryable:boolean = true }
  | loaded { users:UserList }

let <UserCard
  user: UserBase
/> =
  <div class="user-card">
    <h3>{user.name}</h3>
    <p:>ID: {user.id}</p>
    if user.email is {
      null => <p:>No email</p>
      else => <p:>Email: {user.email}</p>
    }
    <p:>Age: {user.age}</p>
  </div>

let describe(user: UserBase) = { user.name }

let currentUser: User =
  <User id={1} name={"Ada"} email={"ada@example.com"} />

let currentStaff: StaffUser =
  <StaffUser id={2} name={"Sam"} department={"Support"} />

let labels: UserList =
  { currentUser currentStaff }

// A bare name at a typed site resolves against the declared type; `{CardSortMode.closed}` also
// works, and is what you write inside a braced expression.
let sortMode: CardSortMode = closed

let defaultStage: DealStage = draft

let loadState: LoadState =
  <LoadState.failed message={"Network unavailable"} />

// Bare case names in pattern position resolve against the scrutinee's type.
let loadStatus = {
  if loadState is {
    idle => "Idle"
    loading => "Loading"
    failed => loadState.message
    loaded => "Loaded"
  }
}

// Negative numeric literals need no braces where a literal is required.
type Offset = { dx: float64 = -1.0  dy: float64 = -1.0 }

let shifted: Offset = <Offset dx=-2.5 />
