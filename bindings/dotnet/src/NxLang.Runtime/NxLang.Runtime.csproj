<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NxLang.Nx</RootNamespace>
    <PackageId>NxLang.Runtime</PackageId>
    <Title>NX Runtime</Title>
    <Description>Managed .NET bindings for the NX runtime with packaged native nx_ffi runtime assets.</Description>
    <PackageTags>nx;runtime;binding;ffi;language</PackageTags>
    <PackageProjectUrl>https://github.com/nx-lang/nx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nx-lang/nx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NxRuntimeNativePackageAssetsRoot Condition="'$(NxRuntimeNativePackageAssetsRoot)' == ''">$(RepoRootPath)artifacts\nx-runtime\</NxRuntimeNativePackageAssetsRoot>
    <NxRuntimeSupportedRids Condition="'$(NxRuntimeSupportedRids)' == ''">linux-x64;osx-arm64;win-x64</NxRuntimeSupportedRids>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(NxRuntimeNativePackageAssetsRoot)runtimes')">
    <None
      Include="$(NxRuntimeNativePackageAssetsRoot)runtimes\**\*"
      Pack="true"
      PackagePath="runtimes" />
  </ItemGroup>

  <Target Name="ValidateNxRuntimeNativePackageAssets" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' != 'false' and '$(NxRuntimeSkipNativePackageAssetValidation)' != 'true'">
    <ItemGroup>
      <_NxRuntimeSupportedRid Include="$(NxRuntimeSupportedRids)" />
      <_NxRuntimeExpectedNativePackageAsset
        Include="$(NxRuntimeNativePackageAssetsRoot)runtimes\%(_NxRuntimeSupportedRid.Identity)\native\libnx_ffi.so"
        Condition="$([System.String]::Copy('%(_NxRuntimeSupportedRid.Identity)').StartsWith('linux-'))" />
      <_NxRuntimeExpectedNativePackageAsset
        Include="$(NxRuntimeNativePackageAssetsRoot)runtimes\%(_NxRuntimeSupportedRid.Identity)\native\libnx_ffi.dylib"
        Condition="$([System.String]::Copy('%(_NxRuntimeSupportedRid.Identity)').StartsWith('osx-'))" />
      <_NxRuntimeExpectedNativePackageAsset
        Include="$(NxRuntimeNativePackageAssetsRoot)runtimes\%(_NxRuntimeSupportedRid.Identity)\native\nx_ffi.dll"
        Condition="$([System.String]::Copy('%(_NxRuntimeSupportedRid.Identity)').StartsWith('win-'))" />
      <_NxRuntimeMissingNativePackageAsset Include="@(_NxRuntimeExpectedNativePackageAsset)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>

    <Error
      Text="Missing NX native runtime package asset '%(_NxRuntimeMissingNativePackageAsset.Identity)'. Run tools/packaging/Stage-NxRuntimeNativeArtifact.ps1 for every supported RID, or set NxRuntimeSkipNativePackageAssetValidation=true for non-release local packing."
      Condition="'@(_NxRuntimeMissingNativePackageAsset)' != ''" />
  </Target>
</Project>
