<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace />
    <NxSdkFailIfNativeLibraryMissing>true</NxSdkFailIfNativeLibraryMissing>
    <!-- MessagePack generates the same resolver type name in this assembly and the SDK assembly. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NxLang.Sdk\NxLang.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <Import Project="..\..\build\NxLang.Sdk.targets" />

</Project>
