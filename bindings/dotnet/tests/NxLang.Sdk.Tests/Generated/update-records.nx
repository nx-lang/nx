// Source for UpdateRecords.g.cs, which `nxlang typegen` generates from this file:
//   nxlang typegen update-records.nx --language csharp --csharp-namespace NxLang.Sdk.Tests.Generated --output UpdateRecords.g.cs
// The nx-cli typegen tests regenerate it and fail if the checked-in file drifts.
export type User = { name:string email?:string }
// The four property shapes: exactly one, optional, one or more, and optional one or more. `author?:` and
// `tags?:` are the clearable fields of `Book.Update`; `authors:Person+` is validated non-empty at the boundary.
export type Person = { name:string }
export type Book = { title:string author?:Person tags?:string+ authors:Person+ }
export type Form = { pending?:User.Update drafts:User.Update+ sortBy?:User.Property }
export component <Counter step:int /> = { state { count:int = 0 } <Label /> }
// A record whose fields are named after the companion's own and base-class members.
export type Clash = { changed:boolean isSet:boolean unset:boolean diff:string fields:string schema:string nxType:string }
export abstract type Shape = { id:string }
export type Circle extends Shape = { }
export type Square extends Shape = { }
export type Doc = { shape:Shape }
export external component <Ticker step:int /> = { state { count:int = 0 } }
// A generic record, emitted as a real C# generic, and one instantiation of it. `patch` and `many`
// are typed by its update companion, which this library declares, so they carry no member formatter
// attribute: MessagePack's source generator closes the companion's own shim. This build and
// `AppliedTypeFields_RoundTripAsTheirInstantiations` are what say that works.
export type Range = { T:type start:T end:T endInclusive:boolean }
export type Schedule = { week:<Range T=int/> spans?:<Range T=float64/>+ patch:<Range.Update T=int/> many:<Range.Update T=int/>+ }
