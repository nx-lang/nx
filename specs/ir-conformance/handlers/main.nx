// Action handlers: emits on components, handlers bound inside a component body and at the root,
// and the lifecycles a host drives: initialize, dispatch by token, emit to the parent.
abstract external component <Node />
external component <Label extends Node text:int />
external component <Button extends Node label:string emits { Tapped { } } />
external component <TextInput extends Node value:string />
external component <Card extends Node items:Node+ header:Node count:int />
component <Stack extends Node content children:Node+ /> = { <column>{children}</column> }

action Reset = { }
action SearchSubmitted = { searchString:string }
action DoSearch = { search:string }

// From examples/nx/component.nx: an owned handler patches the state; a second one also emits.
component <Counter extends Node step:int = 1 emits { Reset } /> = {
  state { count:int = 0 last:State.Property = {State.Property.count} }
  <Stack>
    <Label text={count} />
    <Button label="Add" onTapped=<State.Update count={count + step} last={State.Property.count} /> />
    <Button label="Reset" onTapped={<State.Update count=0 /> <Reset />} />
  </Stack>
}

// A handler in a descriptor prop, and two in a loop whose variable shadows the state field: the
// header's handler reads `count` live at dispatch, the loop's keep the value they captured. `Card`
// declares, and this body writes, `items` before `header`, so only a walk in sorted key order
// numbers the header's handler first.
let tens = { 10 20 }
component <Tens /> = {
  state { count:int = 0 }
  <Card
    items={for count in tens { <Button label="Ten" onTapped=<State.Update count={count + 1} /> /> }}
    header=<Button label="Header" onTapped=<State.Update count={count + 100} /> />
    count={count} />
}

component <SearchBox extends Node placeholder:string = "Find" emits { SearchSubmitted } /> = {
  state { query:string = {placeholder} }
  <TextInput value={query} />
}

// Every handler here is Page's, whichever instance ends up rendering the content child.
component <Page emits { DoSearch } /> = {
  state { count:int = 0 query:string = "" }
  <Stack>
    <Label text={count} />
    <TextInput value={query} />
    <Button label="More" onTapped=<State.Update count={count + 1} /> />
    <SearchBox onSearchSubmitted=<DoSearch search={action.searchString} /> />
    <SearchBox placeholder="Again" onSearchSubmitted=<State.Update query={action.searchString} /> />
  </Stack>
}

// A state patch a handler computes with `diff`, never spelling `State.Update`, still patches the
// state; clearing an optional state field is a present empty field.
component <Diffed extends Node /> = {
  state { count:int = 0 note?:string }
  <Stack>
    <Label text={count} />
    <TextInput value={note ?? "none"} />
    <Button label="Diff" onTapped={diff(<State count={count} />, <State count={count + 1} note="tapped" />)} />
    <Button label="Clear" onTapped=<State.Update note={} /> />
  </Stack>
}

// A state patch is encoded under the state record's name.
let clearNote() = { <Diffed.State.Update note={} /> }

let root() = { <SearchBox onSearchSubmitted=<DoSearch search={action.searchString} /> /> }
