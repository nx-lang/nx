// The module the entry links against: every kind of declaration a reference can reach.
export abstract type Base = { id:int = 7 }
export type User extends Base = { name:string }
export type Theme = light | dark
export let answer(): int = { 42 }
export external component <Card Title:string Theme:Theme = {Theme.light} />
export let makeUser(id:int, name:string): User = <User id={id} name={name} />
