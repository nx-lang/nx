{
  "name": "drawnui-fiddle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fiddle for NX: source on the left, DrawnUI-drawn output on the right.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/*.test.mjs\" && npm run check-examples",
    "check-examples": "node scripts/check-examples.mjs",
    "sync-drawnui": "node scripts/sync-drawnui.mjs",
    "generate-catalog": "node scripts/generate-catalog.mjs"
  },
  "dependencies": {
    "@nx-lang/ir-runtime": "file:../../runtime/typescript",
    "@nx-lang/sdk-node": "file:../../bindings/node",
    "canvaskit-wasm": "^0.42.0",
    "monaco-editor": "^0.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-reconciler": "^0.32.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
