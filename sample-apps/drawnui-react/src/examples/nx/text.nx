// Ported from the DrawnUI React demo's Text page.
//
// SkiaLabel's text engine: wrapping, MaxLines, alignment, spacing, weights, transforms, spans.
//
// The original keeps two readouts — the last tapped span and the last tapped markdown link. NX has
// no event handlers, so those readouts are dropped and the taps do nothing.

component <Card extends DrawnNode Title:string content Children:DrawnNode[] /> = {
  <SkiaShape Type=Rectangle CornerRadius=<CornerRadius TopLeft=8.0 />
    BackgroundColor="#2B3035" HorizontalOptions=Fill>
    <SkiaStack Padding=<Thickness Left=16.0 Top=12.0 Right=16.0 Bottom=12.0 /> Spacing=8.0>
      <SkiaLabel Text={Title} FontSize=12.0 TextColor="#6EA8FE"
        FontAttributes=Bold TextTransform=Uppercase />
      {Children}
    </SkiaStack>
  </SkiaShape>
}

let lorem = "DrawnUI draws every pixel itself: text is shaped and rasterized by Skia, so a label wraps by words, respects MaxLines with an ellipsis, aligns horizontally and vertically, and never leaves the canvas for a native view. This paragraph is long on purpose so it wraps across several lines at whatever width the layout gives it."

// NX string literals span lines, and a newline in the source is a newline in the value. There is
// no `\n` escape: a backslash in a string stays a backslash.
let markdown = "# Heading 1
## Heading 2
### Heading 3
A paragraph with **bold**, *italic*, ~~strikethrough~~, `inline code` and a [tappable link](https://drawnui.net).
Soft line breaks stay inside the paragraph.

- Bullet item with **bold**
- Second bullet
1. Numbered item
2. Another one, *emphasised*

```
const label = new SkiaRichLabel();
label.Text = '# Hello';
```"

<SkiaScroll Orientation=Vertical>
  <SkiaStack Spacing=16.0 Padding=<Thickness Left=16.0 Top=16.0 Right=16.0 Bottom=16.0 />
    HorizontalOptions=Center MaximumWidthRequest=720.0>
    <SkiaLabel Text="SkiaLabel" FontSize=24.0 TextColor="#FFFFFF" HorizontalOptions=Center />

    <Card Title="Word wrap · HorizontalOptions=Fill">
      <SkiaLabel Text={lorem} FontSize=15.0 TextColor="#DEE2E6" HorizontalOptions=Fill />
    </Card>

    <Card Title="Spans — TextSpan children: color, size, bold, italic, underline, strikeout, background">
      <SkiaLabel FontSize=16.0 TextColor="#DEE2E6" HorizontalOptions=Fill FontFamilyFallback="FontSymbols">
        <TextSpan Text="One label, many styles: " />
        <TextSpan Text="bold" IsBold=true />
        <TextSpan Text=", " />
        <TextSpan Text="italic" IsItalic=true />
        <TextSpan Text=", " />
        <TextSpan Text="colored" TextColor="#FFC107" />
        <TextSpan Text=", " />
        <TextSpan Text="bigger" FontSize=22.0 TextColor="#20C997" />
        <TextSpan Text=", " />
        <TextSpan Text="underlined" Underline=true />
        <TextSpan Text=", " />
        <TextSpan Text="struck out" Strikeout=true />
        <TextSpan Text=", " />
        <TextSpan Text=" highlighted " BackgroundColor="#6610F2" TextColor="#FFFFFF" />
        <TextSpan Text=" and a " />
        // The original makes this span tappable and reports the time of the last tap below the
        // paragraph — NX has no event handlers yet, so it is styled as a link but does nothing.
        <TextSpan Text="tappable link →" TextColor="#6EA8FE" Underline=true />
        <TextSpan Text=" that wraps with the rest of the paragraph like any other word." />
      </SkiaLabel>
    </Card>

    <Card Title="SkiaRichLabel — markdown in Text, rendered as spans">
      // The original reports the last markdown link tapped; that readout needs event handlers.
      <SkiaRichLabel FontSize=15.0 TextColor="#DEE2E6" HorizontalOptions=Fill
        FontFamilyFallback="FontSymbols,FontSymbols2" Text={markdown} />
    </Card>

    <Card Title="MaxLines={2} · TailTruncation (default)">
      <SkiaLabel Text={lorem} FontSize=15.0 TextColor="#DEE2E6" HorizontalOptions=Fill MaxLines=2.0 />
    </Card>

    <Card Title="LineSpacing={1.6}">
      <SkiaLabel Text={lorem} FontSize=14.0 TextColor="#DEE2E6" HorizontalOptions=Fill
        LineSpacing=1.6 MaxLines=3.0 />
    </Card>

    <Card Title="HorizontalTextAlignment Start / Center / End">
      <SkiaWrap Spacing=12.0>
        <SkiaLabel Text="Start aligned text wraps inside its own column" FontSize=13.0 TextColor="#DEE2E6"
          WidthRequest=215.0 HorizontalTextAlignment=Start BackgroundColor="#22FFFFFF"
          Padding=<Thickness Left=6.0 Top=6.0 Right=6.0 Bottom=6.0 /> />
        <SkiaLabel Text="Center aligned text wraps inside its own column" FontSize=13.0 TextColor="#DEE2E6"
          WidthRequest=215.0 HorizontalTextAlignment=Center BackgroundColor="#22FFFFFF"
          Padding=<Thickness Left=6.0 Top=6.0 Right=6.0 Bottom=6.0 /> />
        <SkiaLabel Text="End aligned text wraps inside its own column" FontSize=13.0 TextColor="#DEE2E6"
          WidthRequest=215.0 HorizontalTextAlignment=End BackgroundColor="#22FFFFFF"
          Padding=<Thickness Left=6.0 Top=6.0 Right=6.0 Bottom=6.0 /> />
      </SkiaWrap>
    </Card>

    <Card Title="VerticalTextAlignment in a 90pt box">
      <SkiaWrap Spacing=12.0>
        <SkiaLabel Text="Start" FontSize=14.0 TextColor="#DEE2E6" WidthRequest=215.0 HeightRequest=90.0
          VerticalTextAlignment=Start HorizontalTextAlignment=Center BackgroundColor="#22FFFFFF" />
        <SkiaLabel Text="Center" FontSize=14.0 TextColor="#DEE2E6" WidthRequest=215.0 HeightRequest=90.0
          VerticalTextAlignment=Center HorizontalTextAlignment=Center BackgroundColor="#22FFFFFF" />
        <SkiaLabel Text="End" FontSize=14.0 TextColor="#DEE2E6" WidthRequest=215.0 HeightRequest=90.0
          VerticalTextAlignment=End HorizontalTextAlignment=Center BackgroundColor="#22FFFFFF" />
      </SkiaWrap>
    </Card>

    <Card Title="FontFamilyFallback — symbols and emoji the text font lacks">
      <SkiaLabel FontSize=16.0 TextColor="#DEE2E6" FontFamilyFallback="FontSymbols,FontSymbols2"
        HorizontalOptions=Fill
        Text="Arrows ← ↑ → ↓ ⇒ ⇔  math ∑ ∞ ≈ ≠ ≤ ≥ √  misc ♥ ★ ✓ ✗ ⚠ via FontFamilyFallback" />
      <SkiaLabel FontSize=16.0 TextColor="#DEE2E6" FontFamilyFallback="FontEmoji" HorizontalOptions=Fill
        Text="Emoji 😀 😎 🤖 😂 👍 🙌 via FontFamilyFallback=FontEmoji" />
      <SkiaLabel FontSize=16.0 TextColor="#ADB5BD" HorizontalOptions=Fill
        Text="Without a fallback the same arrow → and emoji 😀 render as tofu" />
    </Card>

    <Card Title="FontAttributes / FontWeight (weights registered via ConfigureFonts)">
      <SkiaLabel Text="Regular 400 — the family default" FontSize=16.0 TextColor="#DEE2E6" />
      <SkiaLabel Text="FontAttributes=Bold → nearest registered weight (600 Semibold)" FontSize=16.0
        TextColor="#DEE2E6" FontAttributes=Bold FontFamilyFallback="FontSymbols" />
      <SkiaLabel Text="FontAttributes=Italic → synthetic skew when no italic face" FontSize=16.0
        TextColor="#DEE2E6" FontAttributes=Italic FontFamilyFallback="FontSymbols" />
      <SkiaLabel Text="FontAttributes=BoldItalic" FontSize=16.0 TextColor="#DEE2E6" FontAttributes=BoldItalic />
      <SkiaLabel Text="FontWeight={600} explicit" FontSize=16.0 TextColor="#DEE2E6" FontWeight=600.0 />
    </Card>

    <Card Title="TextTransform · NoWrap · Padding">
      <SkiaLabel Text="uppercase transform applied at layout time" FontSize=14.0 TextColor="#DEE2E6"
        TextTransform=Uppercase />
      <SkiaLabel Text="Titlecase transform applied at layout time" FontSize=14.0 TextColor="#DEE2E6"
        TextTransform=Titlecase />
      <SkiaLabel FontSize=14.0 TextColor="#DEE2E6" LineBreakMode=NoWrap HorizontalOptions=Fill
        Text="LineBreakMode=NoWrap keeps this on one line even when it is far too long for the card width, so it simply runs past the edge" />
      <SkiaLabel Text="Padding={new Thickness(12, 6)} + background" FontSize=14.0 TextColor="#FFFFFF"
        BackgroundColor="#0D6EFD" Padding=<Thickness Left=12.0 Top=6.0 Right=12.0 Bottom=6.0 /> />
    </Card>

    <Card Title="Multiline text with explicit line breaks">
      <SkiaLabel FontSize=14.0 TextColor="#DEE2E6"
        HorizontalTextAlignment=Center HorizontalOptions=Fill
        Text="Line one
Line two is a bit longer
Line three" />
    </Card>
  </SkiaStack>
</SkiaScroll>
