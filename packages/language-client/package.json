{
  "name": "@nx-lang/language-client",
  "version": "0.1.0",
  "description": "The browser side of the NX language protocol: an HTTP implementation of NxLanguageService with headers, timeouts and cancellation.",
  "license": "MIT",
  "homepage": "https://nx-lang.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-lang/nx.git",
    "directory": "packages/language-client"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "prepack": "pnpm run build",
    "verify:package": "node ../../scripts/verify-package.mjs"
  },
  "dependencies": {
    "@nx-lang/language-protocol": "workspace:*"
  },
  "devDependencies": {
    "@nx-lang/language-http": "workspace:*",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
