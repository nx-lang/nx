{
  "name": "@nx-lang/monaco",
  "version": "0.1.0",
  "description": "One Monaco integration for NX: highlighting from the published grammar through Shiki, hover and completion over an NxLanguageService, and diagnostics-to-marker mapping.",
  "license": "MIT",
  "homepage": "https://nx-lang.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-lang/nx.git",
    "directory": "packages/monaco"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "prepack": "pnpm run build",
    "verify:package": "node ../../scripts/verify-package.mjs"
  },
  "dependencies": {
    "@nx-lang/language-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@nx-lang/language": ">=0.1.0",
    "@shikijs/monaco": "^4.0.0",
    "monaco-editor": ">=0.56.0",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@nx-lang/language": "file:../../src/vscode",
    "@shikijs/monaco": "^4.4.3",
    "@types/node": "^22.20.0",
    "monaco-editor": "^0.56.0",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
