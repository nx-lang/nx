{
  "name": "@nx-lang/viewer",
  "version": "0.1.0",
  "description": "An <nx-viewer> custom element that shows an NX document's source as a reading view: elements read as groups and lines without tags or quotes, code reads as written in the editor's colors, and every piece is one click from its source. No framework.",
  "license": "MIT",
  "homepage": "https://nxlang.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-lang/nx.git",
    "directory": "packages/viewer"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "sideEffects": [
    "./dist/src/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "pnpm run build && node --test \"dist/test/**/*.test.js\"",
    "prepack": "pnpm run build",
    "verify:package": "node ../../scripts/verify-package.mjs"
  },
  "dependencies": {
    "@nx-lang/language-protocol": "workspace:*"
  },
  "devDependencies": {
    "@nx-lang/sdk-wasm": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
